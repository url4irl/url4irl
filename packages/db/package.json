    "vitest": "^1.6.0"
  },
  "peerDependencies": {
    "postgres": "^3.4.4",
    "mysql2": "^3.9.7",
    "better-sqlite3": "^10.0.0"
  },
  "peerDependenciesMeta": {
    "postgres": {
      "optional": true
    },
    "mysql2": {
      "optional": true
