{
  "name": "@url4irl/db",
  "version": "0.1.0",
  "description": "Database abstraction layer with Drizzle ORM for URL4IRL",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "repository": {
    "directory": "packages/db",
    "type": "git",
    "url": "git+https://github.com/url4irl/url4irl.git"
  },
  "engines": {
    "node": ">=16"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
